# Resend API key — used by:
#   - the contact form (src/app/contact/action.ts)
#   - the Rufsan Shares newsletter signup (src/app/actions/newsletter.ts),
#     which currently emails new subscribers' addresses to the site owner
#     rather than calling Resend Audiences (which is gated to paid plans).
# Create a key at https://resend.com/api-keys.
RESEND_API_KEY=

# Upstash Redis — used by src/lib/rateLimit.ts for the contact form
# rate limiter. Without these set, the limiter falls back to an in-memory
# map (fine for local dev, useless on serverless). Create a free database
# at https://console.upstash.com/redis and copy the REST URL/token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
